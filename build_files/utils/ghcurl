#!/usr/bin/env -S bash
set -euo pipefail

# Check for GITHUB_TOKEN in /run/secrets/GITHUB_TOKEN (Podman secret mount)
if [[ -s /run/secrets/GITHUB_TOKEN ]]; then
  GITHUB_TOKEN=$(</run/secrets/GITHUB_TOKEN)
  echo "Using GITHUB_TOKEN from /run/secrets/GITHUB_TOKEN for auth." >&2
  AUTH_HEADER="Authorization: Bearer $GITHUB_TOKEN"
elif [[ -f /run/secrets/GITHUB_TOKEN ]]; then
  echo "WARNING: /run/secrets/GITHUB_TOKEN empty; token didn't reach build." >&2
  echo "WARNING: Falling back to unauthenticated requests (rate limits)." >&2
  AUTH_HEADER=""
else
  echo "GITHUB_TOKEN secret not found. Using unauthenticated requests." >&2
  AUTH_HEADER=""
fi

URL="$1"
shift
OPTIONS=("$@")

if [[ -n "$AUTH_HEADER" ]]; then
  curl --fail --retry 3 -H "$AUTH_HEADER" -LSfs "${OPTIONS[@]}" "$URL"
else
  curl --fail --retry 3 -LSfs "${OPTIONS[@]}" "$URL"
fi